# Replace both placeholders with the verified immutable image and its digest.
SEED_AGENT_IMAGE=ghcr.io/team-cyan/media-agent@sha256:REPLACE_WITH_VERIFIED_DIGEST
SEED_AGENT_IMAGE_DIGEST=sha256:REPLACE_WITH_VERIFIED_DIGEST
# Existing common parent of source and library; configure paths below /media.
MEDIA_PARENT_DIR=/srv/media
# Optional token for Web UI write/search/enqueue requests.
# SEED_AGENT_WEB_TOKEN=change-me
